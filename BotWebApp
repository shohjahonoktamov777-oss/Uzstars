            <div class="prem-name">1 oy</div>
          </div>
          <div class="prem-price">40 990 so'm</div>
        </div>
        <div class="prem-opt" onclick="selectPremium(this, 3, 160990)">
          <div class="prem-opt-left">
            <div class="prem-radio"><div class="prem-radio-dot"></div></div>
            <div class="prem-name">3 oy</div>
          </div>
          <div class="prem-price">160 990 so'm</div>
        </div>
        <div class="prem-opt" onclick="selectPremium(this, 6, 214990)">
          <div class="prem-opt-left">
            <div class="prem-radio"><div class="prem-radio-dot"></div></div>
            <div class="prem-name">6 oy</div>
          </div>
          <div class="prem-price">214 990 so'm</div>
        </div>
        <div class="prem-opt" onclick="selectPremium(this, 12, 384990)">
          <div class="prem-opt-left">
            <div class="prem-radio"><div class="prem-radio-dot"></div></div>
            <div class="prem-name">1 yil</div>
          </div>
          <div class="prem-price">384 990 so'm</div>
        </div>
      </div>
    </div>

    <button class="buy-btn" onclick="buyPremium()">Sotib olish</button>
  </div>
</div>

<!-- PAGE: REYTING -->
<div class="page" id="page-reyting">
  <div class="section-title">🏆 Reyting</div>
  <div class="section-sub">Eng ko'p xarid qilganlar</div>

  <div class="rating-filters">
