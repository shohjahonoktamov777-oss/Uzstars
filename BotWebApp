  </div>
  <div class="nav-item" id="nav-profil" onclick="showPage('profil')">
    <div class="nav-icon">👤</div>
    <div class="nav-label">Profil</div>
    <div class="nav-dot"></div>
  </div>
</div>

<!-- MODAL: TO'LOV -->
<div class="modal-overlay" id="payModal">
  <div class="modal">
    <div class="modal-title">
      <span>To'lov ma'lumotlari</span>
      <button class="modal-close" onclick="closeModal('payModal')">✕</button>
    </div>

    <div class="order-detail">
      <div class="od-row">
        <div class="od-label">Turi</div>
        <div class="od-value" id="modalType">—</div>
      </div>
      <div class="od-row">
        <div class="od-label">Kimga</div>
