<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Uz Stars Servis</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0e1a;
  --card: #111827;
  --card2: #1a2235;
  --blue: #2563eb;
  --blue2: #3b82f6;
  --gold: #f59e0b;
  --text: #f1f5f9;
  --muted: #64748b;
  --green: #10b981;
  --border: #1e293b;
  --premium: #8b5cf6;
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
body { background:var(--bg); color:var(--text); font-family:'Space Grotesk',sans-serif; min-height:100vh; padding-bottom:80px; }

/* HEADER */
.header { background:var(--card); padding:14px 16px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); position:sticky; top:0; z-index:100; }
.logo { display:flex; align-items:center; gap:10px; }
.logo-icon { width:36px; height:36px; background:linear-gradient(135deg,var(--blue),var(--blue2)); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px; }
.logo-name { font-size:16px; font-weight:700; color:var(--text); }
.balance-btn { background:var(--card2); border:1px solid var(--border); color:var(--text); padding:7px 14px; border-radius:20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px; }
.balance-btn span { color:var(--blue2); }

/* PAGES */
.page { display:none; padding:16px; animation:fadeIn .2s ease; }
.page.active { display:block; }
@keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }

/* TABS (menu page) */
.tabs { display:flex; background:var(--card); border-radius:12px; padding:4px; margin-bottom:20px; }
.tab { flex:1; text-align:center; padding:10px; border-radius:9px; font-size:14px; font-weight:600; cursor:pointer; color:var(--muted); transition:.2s; }
.tab.active { background:var(--blue); color:#fff; }

/* SECTION TITLE */
.section-title { font-size:20px; font-weight:700; margin-bottom:4px; }
.section-sub { font-size:13px; color:var(--muted); margin-bottom:20px; }

/* INPUT */
.input-group { margin-bottom:16px; }
.input-label { font-size:13px; font-weight:600; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:.5px; }
.input-wrap { display:flex; align-items:center; background:var(--card); border:1.5px solid var(--border); border-radius:12px; overflow:hidden; transition:.2s; }
.input-wrap:focus-within { border-color:var(--blue); }
.input-wrap input { flex:1; background:transparent; border:none; outline:none; color:var(--text); padding:14px 16px; font-size:15px; font-family:inherit; }
.input-wrap input::placeholder { color:var(--muted); }
.self-btn { background:var(--blue); color:#fff; border:none; padding:10px 14px; font-size:12px; font-weight:700; cursor:pointer; margin:4px; border-radius:8px; white-space:nowrap; font-family:inherit; }

/* AMOUNT INPUT */
.amount-wrap { display:flex; align-items:center; background:var(--card); border:1.5px solid var(--border); border-radius:12px; transition:.2s; }
.amount-wrap:focus-within { border-color:var(--blue); }
.amount-wrap input { flex:1; background:transparent; border:none; outline:none; color:var(--text); padding:14px 16px; font-size:15px; font-family:inherit; }
.amount-price { padding:14px 16px; color:var(--blue2); font-weight:700; font-size:14px; white-space:nowrap; }

/* QUICK AMOUNTS */
.quick-amounts { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
.qa { background:var(--card2); border:1.5px solid var(--border); color:var(--text); padding:8px 16px; border-radius:20px; font-size:14px; font-weight:600; cursor:pointer; transition:.2s; font-family:inherit; }
.qa:hover, .qa.sel { background:var(--blue); border-color:var(--blue); color:#fff; }

/* PREMIUM OPTIONS */
.premium-opts { display:flex; flex-direction:column; gap:10px; margin-bottom:20px; }
.prem-opt { background:var(--card); border:1.5px solid var(--border); border-radius:12px; padding:16px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; transition:.2s; }
.prem-opt.sel { border-color:var(--premium); background:#1a1535; }
.prem-opt-left { display:flex; align-items:center; gap:12px; }
.prem-radio { width:20px; height:20px; border-radius:50%; border:2px solid var(--border); display:flex; align-items:center; justify-content:center; transition:.2s; }
.prem-opt.sel .prem-radio { border-color:var(--premium); background:var(--premium); }
.prem-radio-dot { width:8px; height:8px; border-radius:50%; background:#fff; display:none; }
.prem-opt.sel .prem-radio-dot { display:block; }
.prem-name { font-size:15px; font-weight:600; }
.prem-price { font-size:14px; font-weight:700; color:var(--premium); }

/* BUY BTN */
.buy-btn { width:100%; background:linear-gradient(135deg,var(--blue),var(--blue2)); color:#fff; border:none; padding:16px; border-radius:14px; font-size:16px; font-weight:700; cursor:pointer; font-family:inherit; transition:.15s; margin-top:8px; }
.buy-btn:active { transform:scale(.98); opacity:.9; }
.buy-btn:disabled { opacity:.4; cursor:not-allowed; }

/* BOTTOM NAV */
.bottom-nav { position:fixed; bottom:0; left:0; right:0; background:var(--card); border-top:1px solid var(--border); display:flex; padding:8px 0 12px; z-index:200; }
.nav-item { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; cursor:pointer; padding:4px; }
.nav-icon { font-size:22px; }
.nav-label { font-size:11px; font-weight:600; color:var(--muted); transition:.2s; }
.nav-item.active .nav-label { color:var(--blue2); }
.nav-dot { width:4px; height:4px; border-radius:50%; background:var(--blue); display:none; margin-top:2px; }
.nav-item.active .nav-dot { display:block; }

/* RATING */
.rating-filters { display:flex; gap:8px; margin-bottom:16px; }
.rf { background:var(--card); border:1.5px solid var(--border); color:var(--muted); padding:8px 16px; border-radius:20px; font-size:13px; font-weight:600; cursor:pointer; transition:.2s; font-family:inherit; }
.rf.active { background:var(--blue); border-color:var(--blue); color:#fff; }
.rating-list { display:flex; flex-direction:column; gap:8px; }
.rating-item { background:var(--card); border-radius:12px; padding:14px 16px; display:flex; align-items:center; gap:12px; }
.rating-item.me { background:linear-gradient(135deg,#1e3a5f,#1a2235); border:1.5px solid var(--blue); }
.rank { font-size:16px; font-weight:700; min-width:28px; color:var(--muted); }
.rank.gold { color:var(--gold); }
.rank.silver { color:#94a3b8; }
.rank.bronze { color:#cd7c2e; }
.rating-name { flex:1; font-size:15px; font-weight:600; }
.rating-amount { font-size:14px; font-weight:700; color:var(--blue2); }

/* PROFILE */
.profile-header { background:var(--card); border-radius:16px; padding:20px; margin-bottom:16px; text-align:center; }
.profile-avatar { width:72px; height:72px; border-radius:50%; background:linear-gradient(135deg,var(--blue),var(--premium)); display:flex; align-items:center; justify-content:center; font-size:28px; margin:0 auto 12px; }
.profile-name { font-size:18px; font-weight:700; }
.profile-username { font-size:14px; color:var(--muted); margin-top:4px; }

.weekly-card { background:var(--card); border-radius:16px; padding:20px; margin-bottom:16px; }
.weekly-title { font-size:12px; font-weight:700; color:var(--blue2); text-transform:uppercase; letter-spacing:.8px; margin-bottom:16px; display:flex; align-items:center; gap:6px; }
.progress-bar { background:var(--card2); border-radius:99px; height:6px; margin:12px 0 8px; overflow:hidden; }
.progress-fill { height:100%; background:linear-gradient(90deg,var(--blue),var(--blue2)); border-radius:99px; transition:width .5s ease; }
.progress-info { display:flex; justify-content:space-between; font-size:12px; color:var(--muted); }
.weekly-amount { font-size:22px; font-weight:700; color:var(--blue2); text-align:center; margin-bottom:4px; }
.weekly-goal { font-size:13px; color:var(--muted); text-align:center; }

.profile-menu { background:var(--card); border-radius:16px; overflow:hidden; margin-bottom:16px; }
.profile-menu-item { display:flex; align-items:center; gap:12px; padding:16px; border-bottom:1px solid var(--border); cursor:pointer; transition:.15s; }
.profile-menu-item:last-child { border-bottom:none; }
.profile-menu-item:active { background:var(--card2); }
.pmi-icon { width:36px; height:36px; border-radius:10px; background:var(--card2); display:flex; align-items:center; justify-content:center; font-size:18px; }
.pmi-text { flex:1; font-size:15px; font-weight:600; }
.pmi-arrow { color:var(--muted); font-size:16px; }

.referral-card { background:linear-gradient(135deg,#0f2544,#1a3a6b); border:1px solid #2563eb44; border-radius:16px; padding:20px; margin-bottom:16px; }
.ref-title { font-size:12px; font-weight:700; color:var(--blue2); text-transform:uppercase; letter-spacing:.8px; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
.ref-desc { font-size:13px; color:#94a3b8; margin-bottom:16px; line-height:1.5; }
.ref-bonuses { display:flex; flex-direction:column; gap:8px; margin-bottom:16px; }
.ref-bonus { display:flex; align-items:center; justify-content:space-between; }
.ref-bonus-left { display:flex; align-items:center; gap:8px; font-size:14px; }
.ref-bonus-val { font-size:14px; font-weight:700; color:var(--green); }
.ref-btn { width:100%; background:var(--blue); color:#fff; border:none; padding:14px; border-radius:12px; font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; }

/* MODAL */
.modal-overlay { position:fixed; inset:0; background:#00000088; z-index:300; display:flex; align-items:flex-end; opacity:0; pointer-events:none; transition:.2s; }
.modal-overlay.show { opacity:1; pointer-events:all; }
.modal { background:var(--card); border-radius:20px 20px 0 0; padding:24px; width:100%; transform:translateY(100%); transition:.3s cubic-bezier(.4,0,.2,1); max-height:90vh; overflow-y:auto; }
.modal-overlay.show .modal { transform:translateY(0); }
.modal-title { font-size:18px; font-weight:700; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; }
.modal-close { background:var(--card2); border:none; color:var(--muted); width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:18px; display:flex; align-items:center; justify-content:center; }

.order-detail { background:var(--card2); border-radius:12px; padding:16px; margin-bottom:12px; }
.od-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--border); }
.od-row:last-child { border-bottom:none; }
.od-label { font-size:14px; color:var(--muted); }
.od-value { font-size:14px; font-weight:700; }

.payment-info { background:var(--card2); border-radius:12px; padding:16px; margin-bottom:16px; }
.pi-title { font-size:13px; color:var(--muted); margin-bottom:8px; }
.pi-value { font-size:18px; font-weight:700; letter-spacing:2px; display:flex; align-items:center; justify-content:space-between; }
.copy-btn { background:var(--blue); color:#fff; border:none; padding:6px 12px; border-radius:8px; font-size:12px; font-weight:700; cursor:pointer; font-family:inherit; }

.notice { background:#0f2a1a; border:1px solid #10b98133; border-radius:10px; padding:12px; font-size:13px; color:#6ee7b7; line-height:1.5; margin-bottom:16px; display:flex; gap:8px; }

/* HISTORY */
.history-item { background:var(--card); border-radius:12px; padding:14px 16px; display:flex; align-items:center; gap:12px; margin-bottom:8px; }
.hi-icon { width:40px; height:40px; background:linear-gradient(135deg,#1e3a5f,#1a2235); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; }
.hi-info { flex:1; }
.hi-user { font-size:14px; font-weight:700; }
.hi-detail { font-size:12px; color:var(--muted); margin-top:2px; }
.hi-status { font-size:12px; font-weight:700; color:var(--green); }

/* SETTINGS */
.settings-section { margin-bottom:16px; }
.settings-label { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.8px; margin-bottom:8px; padding:0 4px; }
.settings-card { background:var(--card); border-radius:16px; overflow:hidden; }
.settings-item { display:flex; align-items:center; justify-content:space-between; padding:16px; border-bottom:1px solid var(--border); cursor:pointer; }
.settings-item:last-child { border-bottom:none; }
.si-left { display:flex; align-items:center; gap:12px; }
.si-icon { font-size:20px; }
.si-text { font-size:15px; font-weight:500; }
.toggle { width:44px; height:26px; background:var(--card2); border-radius:13px; position:relative; transition:.2s; cursor:pointer; }
.toggle.on { background:var(--blue); }
.toggle-dot { width:20px; height:20px; background:#fff; border-radius:50%; position:absolute; top:3px; left:3px; transition:.2s; }
.toggle.on .toggle-dot { left:21px; }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="logo">
    <div class="logo-icon">⭐</div>
    <div class="logo-name">Uz Stars Servis</div>
  </div>
  <button class="balance-btn" onclick="showAddBalance()">
    <span id="balanceAmount">0 so'm</span> <b>+</b>
  </button>
</div>

<!-- PAGE: MENU -->
<div class="page active" id="page-menu">
  <div class="tabs">
    <div class="tab active" id="tab-stars" onclick="switchTab('stars')">⭐ Stars olish</div>
    <div class="tab" id="tab-premium" onclick="switchTab('premium')">💎 Premium olish</div>
  </div>

  <!-- STARS TAB -->
  <div id="stars-section">
    <div class="section-title">⭐ Telegram Stars sotib olish</div>
