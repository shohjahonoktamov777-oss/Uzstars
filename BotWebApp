      </div>
      <div class="od-row">
        <div class="od-label">Narx</div>
        <div class="od-value" id="modalPrice" style="color:var(--blue2)">—</div>
      </div>
    </div>

    <div class="payment-info">
      <div class="pi-title">Karta raqami (Hamkorbank/HUMO)</div>
      <div class="pi-value">
        <span>9860 1601 2445 5157</span>
        <button class="copy-btn" onclick="copyCard(this)">Nusxa</button>
      </div>
    </div>

    <div class="payment-info">
      <div class="pi-title">To'lov miqdori</div>
      <div class="pi-value">
        <span id="modalPayAmount">—</span>
        <button class="copy-btn" onclick="copyAmount()">Nusxa</button>
      </div>
    </div>

    <div class="notice">
      <span>ℹ️</span>
      <span>Yuqoridagi kartaga to'lov miqdorini o'tkazing. To'lov tekshirilgach buyurtmangiz bajariladi.</span>
    </div>

    <button class="buy-btn" onclick="confirmPayment()">✅ To'lov qildim</button>
  </div>
</div>

<!-- MODAL: TARIX -->
<div class="modal-overlay" id="historyModal">
  <div class="modal">
    <div class="modal-title">
      <span>🛍 Tarixim</span>
      <button class="modal-close" onclick="closeModal('historyModal')">✕</button>
    </div>
    <div id="historyList">
      <div style="text-align:center;padding:40px;color:var(--muted)">
        <div style="font-size:40px;margin-bottom:12px">📭</div>
        <div>Hozircha buyurtmalar yo'q</div>
      </div>
    </div>
  </div>
</div>

<script>
// STATE
const CARD = '9860160124455157';
const CARD_DISPLAY = '9860 1601 2445 5157';
let currentUser = { id: 0, name: 'Foydalanuvchi', username: 'username' };
let selectedPremium = { months: 1, price: 40990 };
let currentOrder = {};
let history = JSON.parse(localStorage.getItem('uzstars_history') || '[]');
let weeklyTotal = parseInt(localStorage.getItem('uzstars_weekly') || '0');

// TELEGRAM INIT
if (window.Telegram && window.Telegram.WebApp) {
  const tg = window.Telegram.WebApp;
  tg.expand();
  tg.setHeaderColor('#111827');
  tg.setBackgroundColor('#0a0e1a');
  if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
    const u = tg.initDataUnsafe.user;
    currentUser = { id: u.id, name: u.first_name || 'Foydalanuvchi', username: u.username || 'username' };
    document.getElementById('profileName').textContent = currentUser.name;
    document.getElementById('profileUsername').textContent = '@' + currentUser.username;
  }
}

// UPDATE WEEKLY
function updateWeekly() {
  const pct = Math.min((weeklyTotal / 1200000) * 100, 100);
  document.getElementById('weeklyAmount').textContent = weeklyTotal.toLocaleString() + ' so\'m';
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressPct').textContent = pct.toFixed(1) + '%';
  const left = Math.max(0, 1200000 - weeklyTotal);
  document.getElementById('progressLeft').textContent = 'Qolgan: ' + left.toLocaleString() + ' so\'m';
}
updateWeekly();

// PAGES
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  document.getElementById('nav-' + name).classList.add('active');
}

// TABS
function switchTab(tab) {
  document.getElementById('tab-stars').classList.toggle('active', tab === 'stars');
  document.getElementById('tab-premium').classList.toggle('active', tab === 'premium');
  document.getElementById('stars-section').style.display = tab === 'stars' ? 'block' : 'none';
  document.getElementById('premium-section').style.display = tab === 'premium' ? 'block' : 'none';
}

// STARS
function setStars(n) {
  document.getElementById('starsAmount').value = n;
  document.querySelectorAll('.qa').forEach(b => b.classList.toggle('sel', parseInt(b.textContent) === n));
  updateStarsPrice();
}
function updateStarsPrice() {
  const v = parseInt(document.getElementById('starsAmount').value) || 0;
  document.getElementById('starsPriceDisplay').textContent = (v * 200).toLocaleString() + ' so\'m';
}
function setSelf(type) {
  const uname = currentUser.username || 'username';
  document.getElementById(type === 'stars' ? 'starsUsername' : 'premiumUsername').value = uname;
}

// PREMIUM
function selectPremium(el, months, price) {
  document.querySelectorAll('.prem-opt').forEach(o => o.classList.remove('sel'));
  el.classList.add('sel');
  selectedPremium = { months, price };
}

// BUY
function buyStars() {
  const username = document.getElementById('starsUsername').value.trim().replace('@','');
  const stars = parseInt(document.getElementById('starsAmount').value);
  if (!username) { alert('Username kiriting!'); return; }
  if (!stars || stars < 50) { alert('Minimal 50 Stars!'); return; }
  const price = stars * 200;
  currentOrder = { type: 'Stars', typeIcon: '⭐', username, qty: stars + ' Stars', price };
  showPayModal();
}
function buyPremium() {
  const username = document.getElementById('premiumUsername').value.trim().replace('@','');
  if (!username) { alert('Username kiriting!'); return; }
  currentOrder = { type: 'Premium', typeIcon: '💎', username, qty: selectedPremium.months + ' oy', price: selectedPremium.price };
  showPayModal();
}

function showPayModal() {
  document.getElementById('modalType').textContent = currentOrder.typeIcon + ' Telegram ' + currentOrder.type;
  document.getElementById('modalTarget').textContent = '@' + currentOrder.username;
  document.getElementById('modalQty').textContent = currentOrder.qty;
  document.getElementById('modalPrice').textContent = currentOrder.price.toLocaleString() + ' so\'m';
  document.getElementById('modalPayAmount').textContent = currentOrder.price.toLocaleString() + ' so\'m';
  showModal('payModal');
}

function copyCard(btn) {
      navigator.clipboard.writeText(CARD).then(() => {
        btn.textContent = '✓';
        setTimeout(() => btn.textContent = 'Nusxa', 1500);
      });
    }
    function copyAmount(btn) {
      navigator.clipboard.writeText(String(currentOrder.price)).then(() => {
        btn.textContent = '✓';
        setTimeout(() => btn.textContent = 'Nusxa', 1500);
      });
    }
}
function copyAmount() {
  navigator.clipboard.writeText(String(currentOrder.price)).then(() => {
    const btn = event.target;
    btn.textContent = '✓';
    setTimeout(() => btn.textContent = 'Nusxa', 1500);
  });
}

function confirmPayment() {
  // Save to history
  const order = {
    ...currentOrder,
    date: new Date().toLocaleString('uz'),
    status: 'Kutilmoqda'
  };
  history.unshift(order);
  localStorage.setItem('uzstars_history', JSON.stringify(history));
  
  // Send to bot
  if (window.Telegram && window.Telegram.WebApp) {
    window.Telegram.WebApp.sendData(JSON.stringify({
      action: 'payment_confirm',
      type: currentOrder.type,
      username: currentOrder.username,
      qty: currentOrder.qty,
      price: currentOrder.price
    }));
  }
  
  closeModal('payModal');
  alert('✅ So\'rovingiz qabul qilindi!\n\nAdmin to\'lovni tekshirib buyurtmangizni bajaradi.');
}

// RATING (demo data)
const demoRating = {
  day: [
    {name:'Siz', amount:10070, me:true},
    {name:'Abduraxmonov', amount:57000},
    {name:'💜', amount:52800},
    {name:'X A C A H', amount:47500},
  ],
  week: [
    {name:'Foydalanuvchi', amount:653140, me:true},
    {name:'Avazbek', amount:219990},
    {name:'Ikrom', amount:219990},
    {name:'Alijonov', amount:192300},
  ],
  month: [
    {name:'Siz', amount:178380, me:true},
    {name:'Abduraxmonov', amount:57000},
    {name:'💜', amount:52800},
  ]
};
function filterRating(btn, period) {
  document.querySelectorAll('.rf').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const data = demoRating[period] || demoRating.day;
  const list = document.getElementById('ratingList');
  const medals = ['🥇','🥈','🥉'];
  const rankClasses = ['gold','silver','bronze'];
  list.innerHTML = data.map((item, i) => `
    <div class="rating-item ${item.me ? 'me' : ''}">
      <div class="rank ${rankClasses[i] || ''}">${medals[i] || (i+1)}</div>
      <div class="rating-name">${item.name}</div>
      <div class="rating-amount">${item.amount.toLocaleString()} so'm</div>
    </div>
  `).join('');
}
filterRating(document.querySelector('.rf'), 'day');

// HISTORY MODAL
function showHistory() {
  const list = document.getElementById('historyList');
  if (!history.length) {
    list.innerHTML = `<div style="text-align:center;padding:40px;color:var(--muted)"><div style="font-size:40px;margin-bottom:12px">📭</div><div>Hozircha buyurtmalar yo'q</div></div>`;
  } else {
    list.innerHTML = history.map(h => `
      <div class="history-item">
        <div class="hi-icon">${h.typeIcon || '⭐'}</div>
        <div class="hi-info">
          <div class="hi-user">@${h.username}</div>
          <div class="hi-detail">${h.qty} · ${h.price.toLocaleString()} so'm · ${h.date}</div>
        </div>
        <div class="hi-status">${h.status}</div>
      </div>
    `).join('');
  }
  showModal('historyModal');
}

function showMyReferrals() {
  alert('Hozircha takliflaringiz yo\'q.\nDo\'stlaringizni taklif qiling!');
}

function shareReferral() {
  const link = `https://t.me/UzStarsServisBot?start=ref${currentUser.id}`;
  if (window.Telegram && window.Telegram.WebApp) {
    window.Telegram.WebApp.switchInlineQuery(`ref${currentUser.id}`, 'users');
  } else {
    navigator.clipboard.writeText(link);
    alert('Havola nusxalandi:\n' + link);
  }
}

function showAddBalance() {
  alert('Balans tizimi tez orada!');
}

function openSupport() {
      if (window.Telegram && window.Telegram.WebApp) {
        window.Telegram.WebApp.openTelegramLink('https://t.me/UzbStarsServis');
      } else {
        window.open('https://t.me/UzbStarsServis', '_blank');
      }
    }

// MODAL HELPERS
function showModal(id) {
  document.getElementById(id).classList.add('show');
}
function closeModal(id) {
  document.getElementById(id).classList.remove('show');
}
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('show'); });
});
</script>
</body>
</html>
